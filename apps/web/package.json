{
  "name": "@ilya/web",
  "version": "0.1.0",
  "private": true,
  "description": "Ilya web application — SvelteKit",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-reader.mjs && vite dev",
    "build": "node scripts/copy-reader.mjs && vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ilya/blurb": "workspace:*",
    "@ilya/dictionary": "workspace:*",
    "@ilya/phonology": "workspace:*",
    "@ilya/score-parser": "workspace:*",
    "pdfjs-dist": "6.2.108",
    "tesseract.js": "^7.0.0",
    "webmscore": "^1.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.50.1",
    "svelte-check": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.6"
  }
}
