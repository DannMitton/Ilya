{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @ilya/web build",
  "outputDirectory": "apps/web/build",
  "framework": null,
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
